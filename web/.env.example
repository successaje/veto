# Copy to .env.local and fill in from Firebase console > Project settings > Your apps (Web).
# .env.local is git-ignored. Never commit an App Check debug token.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=

# App Check > Apps > your web app > reCAPTCHA Enterprise site key
VITE_RECAPTCHA_ENTERPRISE_SITE_KEY=

# Optional: a registered debug token for local development (otherwise one is printed to the console).
VITE_APPCHECK_DEBUG_TOKEN=
