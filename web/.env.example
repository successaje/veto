# Copy to .env.local and fill in from `firebase apps:sdkconfig WEB` (or Project settings > Your apps).
# .env.local is git-ignored and used by both development and production builds.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=

# App Check > Apps > your web app > reCAPTCHA Enterprise site key. Public by design.
VITE_RECAPTCHA_ENTERPRISE_SITE_KEY=

# The App Check debug token is a secret and belongs in .env.development.local (also git-ignored),
# which production builds never load. A production build fails if it sees one.
# VITE_APPCHECK_DEBUG_TOKEN=
