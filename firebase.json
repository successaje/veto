{
  "firestore": {
    "rules": "firebase/firestore.rules",
    "indexes": "firebase/firestore.indexes.json"
  },
  "hosting": {
    "public": "web/dist",
    "ignore": ["firebase.json", "**/.*", "**/node_modules/**"],
    "cleanUrls": true,
    "rewrites": [
      { "source": "/app", "destination": "/app.html" },
      { "source": "/app/**", "destination": "/app.html" },
      { "source": "/r/**", "destination": "/app.html" }
    ]
  },
  "remoteconfig": {
    "template": "firebase/remoteconfig.template.json"
  },
  "auth": {
    "providers": { "anonymous": true }
  },
  "emulators": {
    "firestore": { "port": 8180 },
    "auth": { "port": 9099 },
    "ui": { "enabled": true }
  }
}
